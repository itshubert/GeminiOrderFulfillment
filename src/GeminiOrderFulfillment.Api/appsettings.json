{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AWS": {
    "UseLocalStack": true,
    "Region": "us-east-1",
    "Profile": "default",
    "EventBridge": {
      "EventBusName": "gemini",
      "Source": "gemini"
    }
  },
  "QueueSettings": {
    "InventoryReserved": "http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/inventory-reserved-fulfillment.fifo",
    "OrderSubmitted": "http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/order-submitted-fulfillment.fifo"
  },
  "AllowedHosts": "*"
}